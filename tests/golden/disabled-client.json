        "name": "http elsewhere throws",
        "env": {},
        "options": {
          "key": "wst_1116qJFWMMHFy3xDdLmvUeyc2S6FrWRhJP51HsvDYdz9fWXzSV",
          "core": "http://core.example"
        },
        "want": {
          "error": "config",
          "says": "https"
        }
      },
      {
        "name": "http on a name that only starts with localhost throws",
        "env": {},
        "options": {
          "key": "wst_1116qJFWMMHFy3xDdLmvUeyc2S6FrWRhJP51HsvDYdz9fWXzSV",
          "core": "http://localhost.example"
        },
        "want": {
          "error": "config",
          "says": "https"
        }
      },
      {
        "name": "http on a subdomain of localhost throws (only the three loopback hosts)",
        "env": {},
        "options": {
          "key": "wst_1116qJFWMMHFy3xDdLmvUeyc2S6FrWRhJP51HsvDYdz9fWXzSV",
