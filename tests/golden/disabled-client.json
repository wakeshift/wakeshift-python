          "core": "http://localhost:8370",
          "logs": []
        }
      },
      {
        "name": "http on 127.0.0.1 is allowed",
        "env": {},
        "options": {
          "key": "wst_1116qJFWMMHFy3xDdLmvUeyc2S6FrWRhJP51HsvDYdz9fWXzSV",
          "core": "http://127.0.0.1:8370"
        },
        "want": {
          "enabled": true,
          "core": "http://127.0.0.1:8370",
          "logs": []
        }
      },
      {
        "name": "http on ::1 is allowed",
        "env": {},
        "options": {
          "key": "wst_1116qJFWMMHFy3xDdLmvUeyc2S6FrWRhJP51HsvDYdz9fWXzSV",
          "core": "http://[::1]:8370"
        },
        "want": {
          "enabled": true,
          "core": "http://[::1]:8370",
          "logs": []
