      },
      {
        "name": "an explicit whitespace key means no key",
        "env": {
          "WAKESHIFT_KEY": "wst_1116qJFWMMHFy3xDdLmvUeyc2S6FrWRhJP51HsvDYdz9fWXzSV"
        },
        "options": {
          "key": "   "
        },
        "want": {
          "enabled": false,
          "core": "https://app.wakeshift.ai",
          "logs": [
            {
              "code": "no_key",
              "level": "debug"
            }
          ]
        }
      },
      {
        "name": "an explicit empty key, required: throws",
        "env": {
          "WAKESHIFT_KEY": "wst_1116qJFWMMHFy3xDdLmvUeyc2S6FrWRhJP51HsvDYdz9fWXzSV"
        },
        "options": {
          "key": "",
          "required": true
        },
        "want": {
          "error": "config",
          "says": "key"
        }
      },
      {
        "name": "an explicit malformed key: throws",
        "env": {},
        "options": {
          "key": "wst_1116qJFWMMHFy3xDdLmvUeyc2S6FrWRhJP51HsvDYdz9fWXzSW"
        },
        "want": {
          "error": "config",
          "says": "key",
          "must_not_contain": [
            "wst_1116qJFWMMHFy3xDdLmvUeyc2S6FrWRhJP51HsvDYdz9fWXzSW",
            "1116qJFW",
            "z9fWXzSW",
            "vUeyc2S6",
            "54",
            "50"
          ]
        }
      },
      {
        "name": "a session key passed as the key: throws, without echoing it",
        "env": {},
        "options": {
          "key": "wsc_fakefakefakefakefakefakefa"
        },
        "want": {
          "error": "config",
          "says": "key",
          "must_not_contain": [
            "wsc_fakefakefakefakefakefakefa",
            "fakefake",
            "kefakefa",
            "efakefak",
            "30",
            "26"
          ]
        }
      },
      {
        "name": "WAKESHIFT_CORE sets the core",
        "env": {
          "WAKESHIFT_KEY": "wst_1116qJFWMMHFy3xDdLmvUeyc2S6FrWRhJP51HsvDYdz9fWXzSV",
          "WAKESHIFT_CORE": "https://core.example"
        },
        "options": {},
        "want": {
          "enabled": true,
          "core": "https://core.example",
          "logs": []
        }
      },
      {
        "name": "WAKESHIFT_CORE empty: the default",
        "env": {
          "WAKESHIFT_KEY": "wst_1116qJFWMMHFy3xDdLmvUeyc2S6FrWRhJP51HsvDYdz9fWXzSV",
          "WAKESHIFT_CORE": ""
        },
        "options": {},
        "want": {
          "enabled": true,
          "core": "https://app.wakeshift.ai",
          "logs": []
        }
      },
      {
        "name": "the core option wins over WAKESHIFT_CORE",
        "env": {
          "WAKESHIFT_KEY": "wst_1116qJFWMMHFy3xDdLmvUeyc2S6FrWRhJP51HsvDYdz9fWXzSV",
          "WAKESHIFT_CORE": "https://env.example"
        },
        "options": {
          "core": "https://opt.example"
        },
        "want": {
          "enabled": true,
          "core": "https://opt.example",
          "logs": []
        }
      },
      {
        "name": "http on localhost is allowed",
        "env": {},
        "options": {
