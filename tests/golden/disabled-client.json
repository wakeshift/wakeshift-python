  },
  "option_checks": {
    "_comment": "Checked at defineEvent, attach and registration, on enabled and disabled clients alike: UsageError (error is its code), the message containing says. go: \"panics\" means Go panics at registration instead of returning (design §2.3 'Go: panics and errors').",
    "cases": [
      {
        "op": "define_event_public_not_boolean",
        "name": "defineEvent: public: \"yes\"",
        "error": "config",
        "says": "public",
        "skip": {
          "go": "Public is a bool"
        }
      },
      {
        "op": "define_event_public_and_personal",
        "name": "defineEvent: public with personal",
        "error": "config",
        "says": "public"
      },
      {
        "op": "define_event_public_and_authorize",
        "name": "defineEvent: public with authorize",
        "error": "config",
        "says": "public"
      },
      {
        "op": "define_event_unknown_option",
        "name": "defineEvent: an unknown option (personnal: true)",
        "error": "config",
        "says": "personnal",
        "skip": {
          "python": "Python's own TypeError",
          "go": "EventDef is a struct: doesn't compile"
        }
      },
      {
        "op": "attach_unknown_builtin",
        "name": "attach: builtinTools { subcribe: false }",
        "error": "config",
        "says": "subcribe",
        "skip": {
          "go": "BuiltinTools is a struct: doesn't compile"
        }
      },
      {
        "op": "attach_builtin_not_boolean",
        "name": "attach: builtinTools { wait: \"yes\" }",
        "error": "config",
        "says": "wait",
        "skip": {
          "go": "BuiltinTools is a struct"
        }
      },
      {
        "op": "attach_unknown_option",
        "name": "attach: an unknown option (requireUsr: true)",
        "error": "config",
        "says": "requireUsr",
        "skip": {
          "python": "Python's own TypeError",
          "go": "AttachOptions is a struct: doesn't compile"
        }
      },
      {
        "op": "attach_wrap_not_events",
        "name": "attach: wrap { start_crawl: [\"crawl.finished\"] } (a string, not an event)",
        "error": "config",
        "says": "wrap",
        "skip": {
          "go": "[]ToolOption: doesn't compile"
        }
      },
      {
        "op": "attach_twice",
        "name": "attach: a second attach on the same server",
        "error": "config",
        "says": "attach",
        "go": "panics"
      },
      {
        "op": "attach_inner_server",
        "name": "attach: an McpServer's inner .server",
        "error": "config",
        "says": "McpServer",
        "skip": {
          "python": "TypeScript only",
          "go": "TypeScript only"
        }
      },
      {
        "op": "register_builtin_name",
        "name": "registerTool / @tool / AddTool named subscribe_events",
        "error": "config",
        "says": "subscribe_events",
        "go": "panics"
      },
      {
        "op": "register_schema_names_wake_arg",
        "name": "registerTool / @tool / AddTool whose input schema names session_key",
        "error": "config",
        "says": "session_key",
        "go": "panics"
      },
      {
        "op": "register_output_names_wakeshift",
        "name": "registerTool / @tool / AddTool whose output schema names wakeshift",
        "error": "config",
        "says": "wakeshift",
        "go": "panics"
      },
      {
        "op": "register_event_from_another_client",
        "name": "registerTool / @tool / AddTool subscribing to another client's event",
        "error": "config",
        "says": "another",
        "go": "panics"
      }
    ]
  },
  "methods": {
    "_comment": "Each method on a disabled client (constructed with no key). The rule: hot paths (emit, subscribe, unsubscribe, currentCall) are no-ops that still run their local checks; anything that must return Wakeshift's data throws UsageError disabled. No case makes a network request. want: works (returns normally), adds (what it adds to the server), value (the property's value; null: TS undefined, Python None, Go zero), resolves (the awaited result, compared field by field; Go: the struct with the error nil), error (throws UsageError with that code; Go returns it), called (whether the vendor's callback runs), returns (Go's Handler). A per-language want (typescript/python/go keys) overrides.",
    "cases": [
      {
        "op": "enabled",
        "name": "wake.enabled / wake.Enabled()",
        "want": {
          "value": false
        }
      },
      {
        "op": "define_event",
        "name": "defineEvent",
        "want": {
          "works": true
        },
        "note": "fully typed; schemas and options checked (option_checks hold on a disabled client)"
      },
      {
        "op": "attach",
        "name": "attach",
        "want": {
          "works": true,
          "adds": "nothing"
        },
        "note": "no built-in tools, no wake arguments, no MCP Events capability or events/* methods, nothing stripped; tools/list is subscribing-tools-list.json's disabled scenario. A second attach on the same server is still refused."
      },
      {
        "op": "handler",
        "name": "Go: attached.Handler(next) and wake.Handler(next, opts)",
        "want": {
          "returns": "next"
        },
        "skip": {
          "typescript": "Go only",
          "python": "Go only"
        }
      },
      {
        "op": "register_tool",
        "name": "registerTool / @tool / AddTool",
        "want": {
          "works": true,
          "adds": "nothing"
        },
        "note": "the tool as the vendor wrote it; the handler still gets a call (a disabled one)"
      },
      {
        "op": "identify",
        "name": "identify",
        "want": {
          "called": false
        },
        "note": "never runs on a disabled client, for any request; call.user is unset"
      },
      {
        "op": "current_call",
        "name": "wake.currentCall() outside any tool call",
        "want": {
          "works": true,
          "call": "disabled"
        },
        "note": "never throws no_call on a disabled client"
      },
      {
        "op": "current_call_in_tool",
        "name": "wake.currentCall() inside a tool",
        "want": {
          "works": true,
          "call": "disabled"
        }
      },
      {
        "op": "call_user",
        "name": "call.user",
        "want": {
          "value": null
        }
      },
      {
        "op": "call_subscribe",
        "name": "call.subscribe(event, valid args)",
        "want": {
          "resolves": {
            "state": "disabled"
          }
        }
      },
      {
        "op": "call_subscribe_bad_arguments",
        "name": "call.subscribe with arguments that don't match",
        "want": {
          "error": "bad_arguments"
        },
        "note": "local checks still run: arguments, the declared events, replay bounds",
        "skip": {
          "go": "Go's types make the mistake impossible"
        }
      },
      {
        "op": "call_subscribe_undeclared",
        "name": "call.subscribe to an event the tool didn't declare",
        "want": {
          "error": "undeclared_subscribe"
        }
      },
      {
        "op": "call_unsubscribe",
        "name": "call.unsubscribe(event, args)",
        "want": {
          "resolves": {
            "ended": false
          }
        },
        "note": "nothing was subscribed on a disabled client, so nothing ends (TS and Python false; Go false, nil)"
      },
      {
        "op": "call_resolve_session",
        "name": "call.resolveSession()",
        "want": {
          "error": "disabled"
        }
      },
      {
        "op": "emit",
