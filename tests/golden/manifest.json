{
  "_comment": "The manifest every SDK sends (PUT /api/apps/v1/manifest), and when. Each SDK's test runs each case against a fake core: it defines the sample events named in define (events-list.json's chat.message, game.turn and ci.run, whose manifest entries that file pins), runs the steps in order, and checks the manifest requests it made (GET and PUT /manifest, nothing else) against requests. In a request's body, an event that's a string is that defined event's manifest entry; an object is listed as it is. The fake core answers GET /manifest with stored ({\"description\": \"\"} if there's none), a PUT with 200 unless the step's answer says otherwise, and an emit with {\"matched\": 0}. Steps: emit (chat.message, with emit's arguments and payload), publish (an explicit publish of the manifest given, answered with answer if set), define (one more sample event). A step with error must fail, its message containing that text; every other step must succeed.",
  "emit": {
    "event": "chat.message",
    "arguments": { "channel": "eng" },
    "payload": { "from": "ada", "text": "shipped it" }
  },
  "cases": [
    {
      "name": "the first emit sends the manifest once, keeping the settings Wakeshift has and replacing its events with the defined ones",
      "define": ["chat.message", "game.turn"],
      "stored": {
        "description": "Team chat for agents",
        "accounts": "app",
        "agent": {
          "wake": [{ "pattern": "chat.*", "description": "Messages in your channels" }],
          "post": [{ "pattern": "chat.message", "description": "Your messages" }],
          "wake_limits": [{ "seconds": 60, "max": 5 }],
          "ttl_days": 30,
          "start_prompt": "Join #general in Agent Chat"
        },
        "others_can_wake": true,
        "preapprove_tools": ["history"],
        "events": [{ "name": "old.event", "description": "Gone from the code.", "topic": "ev/old.event" }]
      },
      "steps": [{ "emit": true }, { "emit": true }],
      "requests": [
        { "method": "GET" },
        {
          "method": "PUT",
          "body": {
            "description": "Team chat for agents",
            "agent": {
              "wake": [{ "pattern": "chat.*", "description": "Messages in your channels" }],
              "post": [{ "pattern": "chat.message", "description": "Your messages" }],
              "wake_limits": [{ "seconds": 60, "max": 5 }],
              "ttl_days": 30,
              "start_prompt": "Join #general in Agent Chat"
            },
            "others_can_wake": true,
            "preapprove_tools": ["history"],
            "events": ["chat.message", "game.turn"]
          }
        }
      ]
    },
    {
      "name": "for an app Wakeshift has no settings for yet, the first emit sends the defined events",
      "define": ["chat.message"],
      "steps": [{ "emit": true }],
      "requests": [{ "method": "GET" }, { "method": "PUT", "body": { "description": "", "events": ["chat.message"] } }]
    },
    {
      "name": "an explicit publish sends the manifest's own events, then the defined ones, and the next emit sends nothing more",
      "define": ["chat.message", "game.turn"],
      "steps": [
        {
          "publish": {
            "description": "Team chat for agents",
            "agent": {
              "wake": [{ "pattern": "chat.*", "description": "Messages in your channels" }],
              "post": [{ "pattern": "chat.message", "description": "Your messages" }],
              "ttl_days": 30
            },
            "others_can_wake": true,
            "preapprove_tools": ["history", "post"],
            "events": [
              {
                "name": "deploy.done",
                "description": "A deploy finished.",
                "arguments": { "type": "object", "properties": {} },
                "payload": { "type": "object", "properties": {} },
                "topic": "ev/deploy.done"
              }
            ]
          }
        },
        { "emit": true }
      ],
      "requests": [
        {
          "method": "PUT",
          "body": {
            "description": "Team chat for agents",
            "agent": {
              "wake": [{ "pattern": "chat.*", "description": "Messages in your channels" }],
              "post": [{ "pattern": "chat.message", "description": "Your messages" }],
              "ttl_days": 30
            },
            "others_can_wake": true,
            "preapprove_tools": ["history", "post"],
            "events": [
              {
                "name": "deploy.done",
                "description": "A deploy finished.",
                "arguments": { "type": "object", "properties": {} },
                "payload": { "type": "object", "properties": {} },
                "topic": "ev/deploy.done"
              },
              "chat.message",
              "game.turn"
            ]
          }
        }
      ]
    },
    {
      "name": "an event defined after an explicit publish: the automatic send is the published manifest with the new event",
      "define": ["chat.message"],
      "steps": [
        { "publish": { "description": "Team chat for agents", "others_can_wake": true, "preapprove_tools": ["history"] } },
        { "define": "ci.run" },
        { "emit": true }
      ],
      "requests": [
        {
          "method": "PUT",
          "body": { "description": "Team chat for agents", "others_can_wake": true, "preapprove_tools": ["history"], "events": ["chat.message"] }
        },
        {
          "method": "PUT",
          "body": { "description": "Team chat for agents", "others_can_wake": true, "preapprove_tools": ["history"], "events": ["chat.message", "ci.run"] }
        }
      ]
    },
    {
      "name": "an explicit publish that failed: the automatic send that follows is the same manifest",
      "define": ["chat.message"],
      "steps": [
        {
          "publish": { "description": "Team chat for agents", "preapprove_tools": ["history"] },
          "answer": { "status": 503, "body": { "error": { "code": "unavailable", "message": "try again" } } },
          "error": "try again"
        },
        { "emit": true }
      ],
      "requests": [
        { "method": "PUT", "body": { "description": "Team chat for agents", "preapprove_tools": ["history"], "events": ["chat.message"] } },
        { "method": "PUT", "body": { "description": "Team chat for agents", "preapprove_tools": ["history"], "events": ["chat.message"] } }
      ]
    },
    {
      "name": "a manifest listing a defined event is refused before anything is sent",
      "define": ["chat.message"],
      "steps": [
        {
          "publish": {
            "description": "Team chat for agents",
            "events": [{ "name": "chat.message", "description": "A message.", "topic": "ev/chat.message" }]
          },
          "error": "chat.message"
        }
      ],
      "requests": []
    },
    {
      "name": "an event defined after a publish that listed it: the automatic send is refused",
      "define": ["chat.message"],
      "steps": [
        {
          "publish": {
            "description": "Team chat for agents",
            "events": [{ "name": "ci.run", "description": "A CI run finished.", "topic": "ev/ci.run" }]
          }
        },
        { "define": "ci.run" },
        { "emit": true, "error": "ci.run" }
      ],
      "requests": [
        {
          "method": "PUT",
          "body": {
            "description": "Team chat for agents",
            "events": [{ "name": "ci.run", "description": "A CI run finished.", "topic": "ev/ci.run" }, "chat.message"]
          }
        }
      ]
    }
  ]
}
