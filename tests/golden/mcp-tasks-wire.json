{
  "comment": "MCP Tasks as a wake path: what every SDK serves to a client on protocol 2026-07-28 that declares the tasks extension, and what it asks Wakeshift. Each case is a JSON-RPC request with no initialize first, as from an app whose identify names the user u1, with one wrapped tool, join, that subscribes nothing and returns \"joined\". core_request is the body the SDK sends to core_path (call.user_agent aside); core_response is Wakeshift's answer; result (or error's code, and a message containing error.message) is the SDK's answer. lists says which requests' tools/list includes the wait tool.",
  "protocol": "2026-07-28",
  "extension": "io.modelcontextprotocol/tasks",
  "hold_seconds": 20,
  "wait_tool": {
    "name": "wakeshift_wait",
    "description": "Wait for this conversation's next Wakeshift messages from this app. Returns at once and keeps waiting in the background: when messages arrive, its result reaches you as a task notification. Call it again after each one, with the session_key Wakeshift gave you.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "session_key": {
          "type": "string",
          "description": "This conversation's session_key, from an earlier result (a secret token, or a handle such as claude-code#2). Keep it to this conversation; don't share or log it."
        },
        "harness": {
          "type": "string",
          "description": "The program you're running in: codex, claude-code, cursor (local CLI or IDE), cursor-cloud (Cursor cloud agent), grok-bot, copilot-cli, opencode, antigravity, openclaw (even when it runs your turns in Codex), hermes, chatgpt, or your program's name if it isn't listed"
        },
        "conversation_id": {
          "type": "string",
          "description": "Your own ID for this conversation, if your program gives you one. Cursor and Grok Bot: the output of `printenv CURSOR_CONVERSATION_ID`. Codex and Antigravity send it automatically; others leave it empty"
        }
      },
      "additionalProperties": false
    }
  },
  "lists": [
    {
      "name": "takes tasks",
      "meta": {
        "io.modelcontextprotocol/protocolVersion": "2026-07-28",
        "io.modelcontextprotocol/clientInfo": { "name": "claude-code", "version": "2.1.314" },
        "io.modelcontextprotocol/clientCapabilities": { "extensions": { "io.modelcontextprotocol/tasks": {} } }
      },
      "wait_tool": true
    },
    {
      "name": "2026-07-28 without the tasks extension",
      "meta": {
        "io.modelcontextprotocol/protocolVersion": "2026-07-28",
        "io.modelcontextprotocol/clientInfo": { "name": "claude-code", "version": "2.1.314" },
        "io.modelcontextprotocol/clientCapabilities": {}
      },
      "wait_tool": false
    },
    {
      "name": "the tasks extension on another protocol",
      "meta": {
        "io.modelcontextprotocol/protocolVersion": "2025-11-25",
        "io.modelcontextprotocol/clientCapabilities": { "extensions": { "io.modelcontextprotocol/tasks": {} } }
      },
      "wait_tool": false
    }
  ],
  "cases": [
