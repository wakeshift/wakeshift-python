      "want": {
        "status": 502,
        "code": "",
        "message": "<html>xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
        "text": "wakeshift: error (502): <html>xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
      }
    },
    {
      "name": "an empty answer is its status",
      "status": 503,
      "content_type": "",
      "body": "",
      "reason_phrase": "Service Unavailable",
      "want": {
        "status": 503,
        "code": "",
        "message": "Service Unavailable",
        "text": "wakeshift: error (503): Service Unavailable"
      }
    },
    {
      "name": "a redirect is an error, not followed",
      "status": 302,
      "content_type": "",
      "body": "",
      "reason_phrase": "Found",
      "want": {
        "status": 302,
        "code": "",
        "message": "Found",
        "text": "wakeshift: error (302): Found"
      }
    }
