  },
  "responses": [
    {
      "name": "Wakeshift's error",
      "status": 403,
      "content_type": "application/json",
      "body": "{\"error\":{\"code\":\"private_topic\",\"message\":\"That topic is private.\"}}",
      "reason_phrase": "Forbidden",
      "want": {
        "status": 403,
        "code": "private_topic",
        "message": "That topic is private.",
        "text": "wakeshift: private_topic (403): That topic is private."
      }
    },
    {
      "name": "Wakeshift's error with a reason",
      "status": 422,
      "content_type": "application/json",
      "body": "{\"error\":{\"code\":\"callback_failed\",\"message\":\"The callback answered 404.\",\"reason\":\"http_4xx\"}}",
      "reason_phrase": "Unprocessable Entity",
      "want": {
        "status": 422,
        "code": "callback_failed",
        "message": "The callback answered 404.",
        "text": "wakeshift: callback_failed (422): The callback answered 404.",
        "reason": "http_4xx"
      }
    },
    {
      "name": "a reason that isn't a string is left out",
      "status": 422,
      "content_type": "application/json",
      "body": "{\"error\":{\"code\":\"callback_failed\",\"message\":\"x\",\"reason\":5}}",
      "reason_phrase": "Unprocessable Entity",
      "want": {
        "status": 422,
        "code": "callback_failed",
        "message": "x",
        "text": "wakeshift: callback_failed (422): x"
      }
    },
    {
      "name": "a code that isn't a string is empty",
      "status": 400,
      "content_type": "application/json",
      "body": "{\"error\":{\"code\":5,\"message\":\"x\"}}",
      "reason_phrase": "Bad Request",
      "want": {
        "status": 400,
        "code": "",
        "message": "x",
        "text": "wakeshift: error (400): x"
      }
    },
    {
      "name": "an error without a message is its body",
      "status": 400,
      "content_type": "application/json",
      "body": "{\"error\":{\"code\":\"bad_request\"}}",
      "reason_phrase": "Bad Request",
      "want": {
        "status": 400,
        "code": "bad_request",
        "message": "{\"error\":{\"code\":\"bad_request\"}}",
        "text": "wakeshift: bad_request (400): {\"error\":{\"code\":\"bad_request\"}}"
      }
    },
    {
      "name": "an error with an empty message is its body",
      "status": 400,
      "content_type": "application/json",
      "body": "{\"error\":{\"code\":\"bad_request\",\"message\":\"\"}}",
      "reason_phrase": "Bad Request",
      "want": {
        "status": 400,
        "code": "bad_request",
        "message": "{\"error\":{\"code\":\"bad_request\",\"message\":\"\"}}",
        "text": "wakeshift: bad_request (400): {\"error\":{\"code\":\"bad_request\",\"message\":\"\"}}"
      }
    },
    {
      "name": "an error that isn't an object",
      "status": 500,
      "content_type": "application/json",
      "body": "{\"error\":\"boom\"}",
      "reason_phrase": "Internal Server Error",
      "want": {
        "status": 500,
        "code": "",
        "message": "{\"error\":\"boom\"}",
        "text": "wakeshift: error (500): {\"error\":\"boom\"}"
      }
    },
    {
      "name": "a proxy's page is its first 200 characters",
      "status": 502,
      "content_type": "text/html",
      "body": "<html></html>",
      "reason_phrase": "Bad Gateway",
      "want": {
        "status": 502,
        "code": "",
        "message": "<html>xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
        "text": "wakeshift: error (502): <html>xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
      }
    },
    {
      "name": "an empty answer is its status",
      "status": 503,
      "content_type": "",
      "body": "",
      "reason_phrase": "Service Unavailable",
      "want": {
        "status": 503,
        "code": "",
        "message": "Service Unavailable",
        "text": "wakeshift: error (503): Service Unavailable"
      }
    },
    {
      "name": "a redirect is an error, not followed",
      "status": 302,
      "content_type": "",
      "body": "",
      "reason_phrase": "Found",
      "want": {
        "status": 302,
        "code": "",
        "message": "Found",
        "text": "wakeshift: error (302): Found"
      }
    }
  ],
  "bad_response": {
    "code": "bad_response",
    "message": "Wakeshift at {core} answered {status} without a JSON object. Check that WAKESHIFT_CORE, or the core option, is the address of the console your key came from",
    "cases": [
      {
        "name": "a proxy's page",
        "status": 200,
        "content_type": "text/html",
        "body": "<html>hello</html>"
      },
      {
        "name": "JSON that isn't an object",
        "status": 200,
        "content_type": "application/json",
        "body": "[1,2]"
      },
      {
        "name": "JSON null",
        "status": 200,
        "content_type": "application/json",
        "body": "null"
      },
      {
        "name": "broken JSON",
        "status": 201,
        "content_type": "application/json",
        "body": "{\"workspace\":"
      },
      {
        "name": "an empty answer",
        "status": 200,
        "content_type": "",
        "body": ""
      }
    ]
  },
  "unreachable": {
    "status": 0,
    "code": "unreachable",
    "message_prefix": "can't reach Wakeshift at {core} (",
