{
  "_about": "How every SDK (pkg/appkit, sdk/typescript, sdk/python) reads Wakeshift's answers: which refusals it retries, the error each answer becomes, the JSON-RPC error each becomes for an MCP Events client, and the error for each mistake the SDK catches before asking Wakeshift (client_checks). {core} stands for the core's address.",
  "retry": {
    "pauses_ms": [
      250,
      1000
    ],
    "cases": [
      {
        "name": "the load balancer's 500, POST",
        "method": "POST",
        "status": 500,
        "content_type": "text/html; charset=UTF-8",
        "body": "<html><head>\n<meta http-equiv=\"content-type\" content=\"text/html;charset=utf-8\">\n<title>500 Server Error</title>\n</head>\n<body text=#000000 bgcolor=#ffffff>\n<h1>Error: Server Error</h1>\n<h2>The server encountered an error and could not complete your request.<p>Please try again in 30 seconds.</h2>\n<h2></h2>\n</body></html>",
        "retried": true
      },
      {
        "name": "the load balancer's 500, GET",
        "method": "GET",
        "status": 500,
        "content_type": "text/html; charset=UTF-8",
        "body": "<html><head>\n<meta http-equiv=\"content-type\" content=\"text/html;charset=utf-8\">\n<title>500 Server Error</title>\n</head>\n<body text=#000000 bgcolor=#ffffff>\n<h1>Error: Server Error</h1>\n<h2>The server encountered an error and could not complete your request.<p>Please try again in 30 seconds.</h2>\n<h2></h2>\n</body></html>",
        "retried": true
      },
      {
        "name": "the load balancer's 500, media type in capitals",
        "method": "PUT",
        "status": 500,
        "content_type": "TEXT/HTML",
        "body": "<html><head>\n<meta http-equiv=\"content-type\" content=\"text/html;charset=utf-8\">\n<title>500 Server Error</title>\n</head>\n<body text=#000000 bgcolor=#ffffff>\n<h1>Error: Server Error</h1>\n<h2>The server encountered an error and could not complete your request.<p>Please try again in 30 seconds.</h2>\n<h2></h2>\n</body></html>",
        "retried": true
      },
      {
        "name": "an HTML 500 that isn't the load balancer's",
        "method": "POST",
        "status": 500,
        "content_type": "text/html",
        "body": "<p>oops</p>",
        "retried": false
      },
      {
        "name": "an HTML 500 whose Server Error is past the first 4 KB",
        "method": "GET",
        "status": 500,
        "content_type": "text/html",
        "body": "<html>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        Server Error</html>",
        "retried": false
      },
      {
        "name": "a plain-text 500 saying Server Error",
        "method": "GET",
        "status": 500,
        "content_type": "text/plain",
        "body": "Server Error",
        "retried": false
      },
      {
        "name": "Wakeshift's own 500",
        "method": "POST",
        "status": 500,
        "content_type": "application/json",
        "body": "{\"error\":{\"code\":\"internal\",\"message\":\"Server Error\"}}",
        "retried": false
      },
      {
        "name": "Wakeshift's own 500, GET",
        "method": "GET",
        "status": 500,
        "content_type": "application/json",
        "body": "{\"error\":{\"code\":\"internal\",\"message\":\"x\"}}",
        "retried": false
      },
      {
        "name": "Cloud Run's 503, GET",
        "method": "GET",
        "status": 503,
        "content_type": "text/html",
        "body": "Service Unavailable",
        "retried": true
      },
      {
        "name": "a 503 without a content type, HEAD",
        "method": "HEAD",
        "status": 503,
        "content_type": "",
        "body": "",
        "retried": true
      },
      {
        "name": "Cloud Run's 503, POST",
        "method": "POST",
        "status": 503,
        "content_type": "text/html",
        "body": "Service Unavailable",
        "retried": false
      },
      {
        "name": "a 503, DELETE",
        "method": "DELETE",
        "status": 503,
        "content_type": "text/html",
        "body": "Service Unavailable",
        "retried": false
      },
      {
        "name": "Wakeshift's own 503, GET",
        "method": "GET",
