  "bad_response": {
    "code": "bad_response",
    "message": "Wakeshift at {core} answered {status} without a JSON object. Check that WAKESHIFT_CORE, or the core option, is the address of the console your key came from",
    "cases": [
      {
        "name": "a proxy's page",
        "status": 200,
        "content_type": "text/html",
        "body": "<html>hello</html>"
      },
      {
        "name": "JSON that isn't an object",
        "status": 200,
        "content_type": "application/json",
        "body": "[1,2]"
      },
      {
        "name": "JSON null",
        "status": 200,
        "content_type": "application/json",
        "body": "null"
      },
      {
        "name": "broken JSON",
        "status": 201,
        "content_type": "application/json",
        "body": "{\"workspace\":"
      },
