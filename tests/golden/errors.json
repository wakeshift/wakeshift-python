  "client_checks": {
    "_about": "Mistakes each SDK refuses before asking Wakeshift. Each is the SDK's API error (Go's *APIError, WakeshiftError in TypeScript and Python) with the status and code Wakeshift answers the same mistake with, and a message containing says; Wakeshift isn't asked. The events are game.turn (personal) and table.news (shared), both with a required string argument table and a payload with a required string text, as in the toolcall tests. Each SDK runs every op its tests know, and fails on an op it doesn't, unless skip names it, with why.",
    "cases": [
      {
        "op": "emit_personal_without_recipient",
        "name": "emit: a personal event without a recipient",
        "status": 400,
        "code": "bad_arguments",
        "says": "is personal"
      },
      {
        "op": "emit_shared_with_recipient",
        "name": "emit: a shared event with a recipient",
        "status": 400,
        "code": "bad_arguments",
        "says": "isn't personal"
      },
      {
        "op": "emit_recipient_without_user",
        "name": "emit: a recipient whose user is empty",
        "status": 400,
        "code": "bad_arguments",
        "says": "a recipient's user is empty"
      },
      {
        "op": "emit_recipient_without_subscription",
        "name": "emit: a subscription recipient whose subscription is empty",
        "status": 400,
        "code": "bad_arguments",
        "says": "a recipient's subscription is empty"
      },
      {
        "op": "emit_bad_arguments",
        "name": "emit: arguments that don't match the event's",
        "status": 400,
        "code": "bad_arguments",
        "says": "arguments for game.turn",
        "skip": {
          "go": "Go's types make the mistake impossible: the arguments and payload are structs"
        }
      },
      {
        "op": "emit_bad_payload",
        "name": "emit: a payload that doesn't match the event's",
        "status": 400,
        "code": "bad_arguments",
        "says": "payload for game.turn",
        "skip": {
          "go": "Go's types make the mistake impossible: the arguments and payload are structs"
        }
      },
      {
        "op": "publish_url_personal_without_to",
        "name": "publish URL: a personal event without to",
        "status": 400,
        "code": "bad_arguments",
        "says": "is personal"
      },
      {
        "op": "publish_url_shared_with_to",
        "name": "publish URL: a shared event with to",
        "status": 400,
        "code": "bad_arguments",
        "says": "isn't personal"
      },
      {
        "op": "publish_url_two_users",
        "name": "publish URL: to with two users",
        "status": 400,
        "code": "bad_arguments",
        "says": "exactly one user"
      },
      {
        "op": "status_personal_without_to",
        "name": "status: a personal event without to",
        "status": 400,
        "code": "bad_arguments",
        "says": "is personal"
      },
      {
        "op": "status_shared_with_to",
        "name": "status: a shared event with to",
        "status": 400,
        "code": "bad_arguments",
        "says": "isn't personal"
      },
      {
        "op": "status_two_users",
        "name": "status: to with two users",
        "status": 400,
        "code": "bad_arguments",
        "says": "exactly one user"
      },
      {
        "op": "status_of_too_many",
        "name": "status of: 1,001 subscriptions",
        "status": 400,
        "code": "bad_request",
        "says": "at most 1000 subscriptions"
      },
      {
        "op": "status_of_without_user",
        "name": "status of: a subscription without its user",
        "status": 400,
        "code": "bad_request",
        "says": "each subscription's user"
      },
      {
        "op": "subscribe_another_apps_event",
        "name": "subscribe: another app's event",
        "status": 404,
        "code": "unknown_event",
        "says": "is another app's event"
      },
      {
        "op": "unsubscribe_another_apps_event",
        "name": "unsubscribe: another app's event",
        "status": 404,
        "code": "unknown_event",
        "says": "is another app's event"
      },
      {
        "op": "subscribe_personal_without_user",
        "name": "subscribe: a personal event, the caller unidentified",
        "status": 400,
        "code": "bad_arguments",
        "says": "is personal"
      },
      {
        "op": "subscribe_bad_arguments",
        "name": "subscribe: arguments that don't match the event's",
        "status": 400,
        "code": "bad_arguments",
        "says": "arguments for game.turn",
        "skip": {
          "go": "Go's types make the mistake impossible: the arguments and payload are structs"
        }
      }
    ]
