{
  "_about": "How every SDK (pkg/wakeshift, sdk/typescript, sdk/python) reads Wakeshift's answers: which refusals it retries, the error each answer becomes, the JSON-RPC error each becomes for an MCP Events client, and the error for each mistake the SDK catches before asking Wakeshift (client_checks). {core} stands for the core's address.",
  "retry": {
    "pauses_ms": [
      250,
      1000
    ],
    "cases": [
      {
        "name": "the load balancer's 500, POST",
        "method": "POST",
        "status": 500,
        "content_type": "text/html; charset=UTF-8",
        "body": "<html><head>\n<meta http-equiv=\"content-type\" content=\"text/html;charset=utf-8\">\n<title>500 Server Error</title>\n</head>\n<body text=#000000 bgcolor=#ffffff>\n<h1>Error: Server Error</h1>\n<h2>The server encountered an error and could not complete your request.<p>Please try again in 30 seconds.</h2>\n<h2></h2>\n</body></html>",
        "retried": true
      },
      {
