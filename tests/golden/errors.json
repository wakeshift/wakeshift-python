        "name": "a 502, GET",
        "method": "GET",
        "status": 502,
        "content_type": "text/html",
        "body": "Bad Gateway",
        "retried": true
      },
      {
        "name": "a 502, PUT",
        "method": "PUT",
        "status": 502,
        "content_type": "text/html",
        "body": "Bad Gateway",
        "retried": false
      },
      {
        "name": "a 504, GET",
        "method": "GET",
        "status": 504,
        "content_type": "text/plain",
        "body": "upstream request timeout",
        "retried": true
      },
      {
        "name": "a problem+json 503 isn't Wakeshift's, GET",
        "method": "GET",
        "status": 503,
        "content_type": "application/problem+json",
        "body": "{\"title\":\"x\"}",
        "retried": true
      },
      {
        "name": "a 501, GET",
        "method": "GET",
        "status": 501,
        "content_type": "text/html",
        "body": "Not Implemented",
        "retried": false
      },
      {
        "name": "a 429, GET",
        "method": "GET",
        "status": 429,
        "content_type": "text/html",
        "body": "Too Many Requests",
        "retried": false
      },
      {
        "name": "a 200 saying Server Error",
        "method": "GET",
        "status": 200,
        "content_type": "text/html",
        "body": "<html><head>\n<meta http-equiv=\"content-type\" content=\"text/html;charset=utf-8\">\n<title>500 Server Error</title>\n</head>\n<body text=#000000 bgcolor=#ffffff>\n<h1>Error: Server Error</h1>\n<h2>The server encountered an error and could not complete your request.<p>Please try again in 30 seconds.</h2>\n<h2></h2>\n</body></html>",
        "retried": false
